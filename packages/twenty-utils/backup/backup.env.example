# This file is copied to:
# ~/Library/Application Support/Twenty Backup/config.env
# Keep it mode 600. Do not commit credentials or the restic password here.

TWENTY_BACKUP_PRIMARY_VOLUME=TWENTY_BACKUP_A
TWENTY_BACKUP_SECONDARY_VOLUME=TWENTY_BACKUP_B
TWENTY_BACKUP_PRIMARY_REPOSITORY_PATH=restic/twenty
TWENTY_BACKUP_SECONDARY_REPOSITORY_PATH=restic/twenty

# External repositories are optional. Set either flag to true only when its
# absence should make backup-health.sh report a coverage problem.
TWENTY_BACKUP_REQUIRE_PRIMARY=false
TWENTY_BACKUP_REQUIRE_SECONDARY=false

TWENTY_BACKUP_DATABASE_NAME=default
TWENTY_BACKUP_DATABASE_USER=postgres
TWENTY_BACKUP_HOST=twenty-local

# Optional overrides:
# TWENTY_BACKUP_STORAGE_PATH=/absolute/path/to/.local-storage
# TWENTY_BACKUP_INTERNAL_REPOSITORY=/absolute/path/to/internal/repository
# TWENTY_BACKUP_KEYCHAIN_SERVICE=com.twenty.local-backup.restic
