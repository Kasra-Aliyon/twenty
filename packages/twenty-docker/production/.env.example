# Copy into Coolify's runtime environment. Never commit real values.
TWENTY_PUBLIC_URL=https://crm.example.com
TWENTY_IMAGE=ghcr.io/kasra-aliyon/twenty-production@sha256:REPLACE_WITH_BUILD_DIGEST
TWENTY_MCP_IMAGE=ghcr.io/kasra-aliyon/twenty-mcp@sha256:REPLACE_WITH_BUILD_DIGEST
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_URL_SAFE_PASSWORD
APP_SECRET=REPLACE_OR_PRESERVE_EXISTING_APP_SECRET
ENCRYPTION_KEY=REPLACE_OR_PRESERVE_EXISTING_ENCRYPTION_KEY
TWENTY_API_KEY=REPLACE_WITH_SCOPED_CRM_API_KEY
TWENTY_MCP_HTTP_BEARER_TOKEN=REPLACE_WITH_RANDOM_MCP_ACCESS_TOKEN
TWENTY_MCP_ALLOWED_ORIGINS=https://crm.example.com
# Enable only after installing a dedicated user's token pair into the volume.
TWENTY_USER_SESSION_FILE=
# Configure SMTP before relying on invitations, verification or password reset.
EMAIL_DRIVER=logger
EMAIL_FROM_ADDRESS=
EMAIL_SMTP_HOST=
EMAIL_SMTP_PORT=587
EMAIL_SMTP_USER=
EMAIL_SMTP_PASSWORD=
