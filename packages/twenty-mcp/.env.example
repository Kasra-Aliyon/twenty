TWENTY_BASE_URL=http://localhost:3000
TWENTY_API_KEY=
# Optional user access token for Unibox resolvers.
TWENTY_USER_TOKEN=
TWENTY_METADATA_CACHE_TTL_MS=300000
TWENTY_REQUEST_TIMEOUT_MS=15000
TWENTY_MAX_RETRIES=2
# Enables permanent destroy and high-volume message/attachment read tools.
TWENTY_ENABLE_ADVANCED=false
TRANSPORT=stdio
HOST=127.0.0.1
PORT=3333
# Required when HTTP HOST is not localhost/127.0.0.1/::1.
TWENTY_MCP_HTTP_BEARER_TOKEN=
