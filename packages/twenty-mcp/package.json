{
  "name": "twenty-mcp-server",
  "version": "0.1.0",
  "description": "Model Context Protocol server for Twenty CRM",
  "type": "module",
  "license": "AGPL-3.0",
  "private": true,
  "bin": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "USAGE_GUIDE.md",
    "manifest.json"
  ],
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "mcpb:pack": "yarn build && node scripts/prepare-mcpb.mjs && mcpb validate .mcpb-build && mcpb pack .mcpb-build twenty-mcp-server.mcpb",
    "mcpb:validate": "mcpb validate manifest.json",
    "start": "node dist/index.js",
    "test": "jest --config jest.config.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "express": "5.2.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@types/express": "^5.0.5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.1",
    "jest": "29.7.0",
    "rimraf": "^6.0.1",
    "ts-jest": "^29.4.5",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": "^24.5.0",
    "npm": "please-use-yarn",
    "yarn": "^4.0.2"
  }
}
