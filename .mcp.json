{
  "mcpServers": {
    "postgres": {
      "type": "stdio",
      "command": "bash",
      "args": [
        "-c",
        "set -a && source packages/twenty-server/.env && set +a && npx -y @modelcontextprotocol/server-postgres \"$PG_DATABASE_URL\""
      ],
      "env": {}
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--no-sandbox",
        "--headless"
      ],
      "env": {}
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ],
      "env": {}
    }
  }
}
