{
  "mcpServers": {
    "postgres": {
      "type": "stdio",
      "command": "bash",
      "args": ["-c", "source packages/twenty-server/.env && npx -y @modelcontextprotocol/server-postgres \"$PG_DATABASE_URL\""],
      "env": {}
    },
    "playwright": {
      "type": "stdio",
      "command": "npx",
      "args": ["@playwright/mcp@latest", "--no-sandbox", "--headless"],
      "env": {}
    },
    "context7": {
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp"],
      "env": {}
    },
    "twenty": {
      "type": "stdio",
      "command": "/opt/homebrew/bin/node",
      "args": ["packages/twenty-mcp/dist/index.js"],
      "env": {
        "TWENTY_BASE_URL": "http://localhost:3000",
        "TWENTY_API_KEY": "${TWENTY_API_KEY}",
        "TWENTY_ENABLE_ADVANCED": "false"
      }
    }
  }
}
